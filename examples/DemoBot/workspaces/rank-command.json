{
  "name": "Rank command",
  "nodes": {
    "a1": {
      "block": "discord.on_slash_command@2",
      "at": [40, 60],
      "values": { "command": "rank" }
    },
    "b2": {
      "block": "core.get_stored@1",
      "at": [40, 360],
      "values": { "scope": "user", "key": "xp", "fallback": 0 },
      "pins": ["target"]
    },
    "c3": {
      "block": "discord.build_embed@2",
      "at": [360, 60],
      "values": {
        "embed": {
          "color": "#00D8F0",
          "title": "Rank of {user}",
          "description": "You have **{xp} XP**. Keep chatting to level up!",
          "fields": [
            { "name": "Level", "value": "{level}", "inline": true },
            { "name": "Server", "value": "{server}", "inline": true }
          ],
          "footer": { "text": "DemoBot" },
          "timestamp": true
        }
      },
      "pins": ["xp", "level"]
    },
    "f6": {
      "block": "core.math@1",
      "at": [40, 560],
      "values": { "a": 0, "op": "divide", "b": 100 },
      "pins": ["a"]
    },
    "d4": {
      "block": "discord.send_message@3",
      "at": [760, 120],
      "values": { "mode": "reply", "text": "GG {user}! Here's your rank.", "private": true },
      "pins": ["embeds"],
      "zone": "z1"
    },
    "e5": {
      "block": "core.log@1",
      "at": [1150, 440],
      "values": { "message": "Could not reply to /rank", "level": "warn" },
      "pins": ["message"]
    }
  },
  "links": [
    "a1.next > c3.in",
    "c3.next > d4.in",
    "a1.interaction > d4.interaction",
    "a1.user > b2.target",
    "b2.value > c3.xp",
    "b2.value > f6.a",
    "f6.result > c3.level",
    "c3.embed > d4.embeds",
    "z1.error > e5.in",
    "z1.message > e5.message"
  ],
  "zones": {
    "z1": { "title": "Rank reply", "rect": [732, 76, 336, 418], "retry": 1 }
  }
}
