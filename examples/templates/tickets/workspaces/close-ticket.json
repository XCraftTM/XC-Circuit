    "6": {
      "block": "discord.create_transcript@1",
      "at": [
        740,
        760
      ],
      "values": {
        "limit": 1000,
        "images": false,
        "bots": true
      }
    },
    "7": {
      "block": "discord.find_channel@1",
      "at": [
        1080,
        760
      ],
      "values": {
        "channel": "ticket-logs"
