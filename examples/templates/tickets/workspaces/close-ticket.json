      "at": [
        780,
        140
      ],
      "values": {
        "mode": "reply",
        "private": true,
        "format": "layout"
      }
    },
    "4": {
      "block": "discord.on_button@1",
      "at": [
        60,
        760
      ],
      "values": {
        "customId": "ticket-close-confirm"
      }
