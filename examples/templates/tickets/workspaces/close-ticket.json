    "8": {
      "block": "discord.send_message@3",
      "at": [
        1420,
        760
      ],
      "values": {
        "mode": "send",
        "text": "📄 **#${#4.channel.name}** was closed by ${user}. The transcript holds ${#6.count} messages."
